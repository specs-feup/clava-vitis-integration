{
  "name": "@specs-feup/clava-vitis-integration",
  "version": "1.1.0",
  "author": "Tiago Lascasas Santos <tiagolascasas@outlook.com> (https://tiagolascasas.dev)",
  "description": "A Clava extension to interact with AMD/Xilinx's Vitis ",
  "type": "module",
  "private": false,
  "scripts": {
    "example:proj": "clava dist/examples/SingleFileProject.js -- clang inputs/scenarioA",
    "example:syn": "clava dist/examples/SingleFileSynthesis.js -- clang inputs/scenarioB.cpp",
    "example:impl": "clava dist/examples/SingleFileImpl.js -- clang inputs/scenarioB.cpp",
    "example:report-syn": "clava dist/examples/SynReportParsing.js",
    "example:report-impl": "clava dist/examples/ImplReportParsing.js",
    "example:edgedetect-syn": "clava dist/examples/EdgedetectSyn.js -- clang inputs/edgedetect",
    "example:edgedetect-impl": "clava dist/examples/EdgedetectImpl.js -- clang inputs/edgedetect",
    "example:pragmas": "clava dist/examples/DirectiveInsertion.js -- clang inputs/edgedetect",
    "example:pragmas-syn": "clava dist/examples/DirectiveSynthesis.js -- clang inputs/edgedetect",
    "example:unsynthesis": "clava dist/examples/Unsynthesizability.js -- clang inputs/unsynthesizable",
    "example:dse": "clava dist/examples/DesignSpaceExploration.js -- clang inputs/dotprod",
    "test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit test",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "docs": "typedoc",
    "test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit src",
    "test:cov": "npm run test -- --coverage",
    "test:watch": "npm run test -- --watch"
  },
  "exports": {
    "./VitisHlsConfig": "./dist/src/VitisHlsConfig.js",
    "./VitisReports": "./dist/src/VitisReports.js",
    "./VitisHls": "./dist/src/VitisHls.js",
    "./VitisSynReportParser": "./dist/src/VitisSynReportParser.js",
    "./VitisImplReportParser": "./dist/src/VitisImplReportParser.js",
    "./HlsDirective": "./dist/src/directives/HlsDirective.js",
    "./HlsArrayPartition": "./dist/src/directives/HlsArrayPartition.js",
    "./HlsInline": "./dist/src/directives/HlsInline.js",
    "./HlsPipeline": "./dist/src/directives/HlsPipeline.js",
    "./HlsUnroll": "./dist/src/directives/HlsUnroll.js"
  },
  "files": [
    "dist/src"
  ],
  "dependencies": {
    "@specs-feup/clava": "^3.5.2",
    "chalk": "^5.3.0",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typedoc": "^0.26.4",
    "typescript": "^5.5.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specs-feup/clava-vitis-integration.git"
  }
}
